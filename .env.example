# ─── Good Team environment ────────────────────────────────────────────────
# Copy to .env.local for development. In Docker these come from compose/env.

# Public base URL (used for canonical URLs, sitemap, OG images, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where runtime data lives (SQLite DB, uploads, backups).
# In Docker this is the mounted volume: /data
DATA_DIR=./data

# 32+ random bytes, base64. Used to sign/encrypt server-side secrets
# (e.g. API token peppers, share-link HMACs). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=change-me-to-a-long-random-string

# Optional: bootstrap the owner account on first boot (otherwise use /setup).
# OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=a-long-passphrase
# OWNER_NAME=Your Name

# Default timezone for rendering dates on the server.
APP_TIMEZONE=Asia/Tehran
